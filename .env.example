# =============================================================================
# REQUIRED — the app will not start (or will silently misbehave) without these
# =============================================================================

# PostgreSQL connection string. Required.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_agent_studio"

# Redis connection string. Required in production — Redis backs the
# rate limiters on login, registration, agent execution, API key creation,
# and MCP connection testing (see src/lib/rate-limit.ts). If Redis is
# unreachable the app still runs (rate limiting fails open with a logged
# warning instead of blocking requests), but you should not run production
# traffic without it actually up.
REDIS_URL="redis://localhost:6379"

# Signs session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Encrypts model provider API keys and MCP server auth headers at rest
# (AES-256-GCM). Use a DIFFERENT random value than AUTH_SECRET.
#   openssl rand -base64 32
ENCRYPTION_SECRET="replace-with-a-different-long-random-string"

# =============================================================================
# OPTIONAL
# =============================================================================

# Google OAuth ("Continue with Google"). Email/password auth works without
# these. See README "Google OAuth production setup" for exact console config.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Enables the built-in Web Search tool (Bing Web Search API). Without it,
# the tool returns a clearly-labeled "not configured" placeholder instead
# of failing or fabricating results.
SEARCH_API_KEY=""

# Used to build deployment endpoint URLs shown in the UI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NOTE: Anthropic/OpenAI/Gemini API keys are NOT set here as env vars.
# Add them per-account from the in-app Models page — they're encrypted
# with ENCRYPTION_SECRET before being written to Postgres.
